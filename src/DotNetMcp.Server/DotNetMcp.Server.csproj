<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Version: 默认 0.0.0-dev，发布时由 CI 通过 Tag 替换 -->
    <Version>0.0.0-dev</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <InformationalVersion>0.0.0-dev</InformationalVersion>

    <!-- 程序集信息 -->
    <Product>DotNet MCP Server</Product>
    <Description>MCP Server for .NET assembly analysis and modification</Description>
    <Authors>xjoker</Authors>
    <RepositoryUrl>https://github.com/xjoker/DotNetMCP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.2.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetMcp.Backend\DotNetMcp.Backend.csproj" />
  </ItemGroup>

</Project>
